{
  "name": "kwizly",
  "version": "1.0.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Werwllleh/kwizly.git"
  },
  "scripts": {
    "dev": "pnpm run nest-dev",
    "nest-dev": "pnpm --filter @kwizly/api start:dev",
    "nest-start": "pnpm --filter @kwizly/api start:prod",
    "nest-build": "pnpm --filter @kwizly/api build",
    "build": "pnpm run nest-build",
    "lint": "pnpm --filter @kwizly/api lint"
  },
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "@nestjs/common": "^12.1.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.0",
    "@nestjs/platform-express": "^12.1.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.7",
    "@nestjs/schematics": "^12.0.5",
    "@nestjs/testing": "^12.1.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "dotenv": "^18.0.4",
    "eslint": "^10.11.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.9",
    "prisma": "^7.10.0",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "zod": "^4.6.5",
    "zod-openapi": "^6.0.2"
  }
}
